# Copia estos nombres en Vercel -> Settings -> Environment Variables (o en un archivo .env local).
# Genera cada clave con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Autentica al robot (pasarela Jetson) contra /api/telemetry y /api/command
ROBOT_API_KEY=

# Firma las sesiones de los usuarios. Si la cambias, todos deben iniciar sesión de nuevo.
AUTH_SECRET=

# Base de datos Upstash Redis (Vercel las crea solas al conectar el Storage)
KV_REST_API_URL=
KV_REST_API_TOKEN=
